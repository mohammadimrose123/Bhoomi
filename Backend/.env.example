# Local development template only. Replace every CHANGE_ME/REPLACE value before use.
DB_URL=jdbc:postgresql://127.0.0.1:5432/bhoomi_db
DB_NAME=bhoomi_db
DB_PORT=5432
DB_USER=bhoomi_user
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_LOCAL_POSTGRES_ADMIN_PASSWORD
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_RANDOM_32_BYTE_SECRET
JWT_ISSUER=bhoomi
JWT_EXPIRATION=PT1H
PASSWORD_RESET_EXPIRATION=PT15M
FRONTEND_BASE_URL=http://localhost:5173
# Leave disabled until real SMTP credentials and a verified sender are configured.
BHOOMI_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bhoomi.local
SMTP_AUTH=true
SMTP_STARTTLS=true
