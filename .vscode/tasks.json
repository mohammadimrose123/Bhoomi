{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Maven: compile Backend (wrapper)",
            "type": "shell",
            "command": ".\\mvnw.cmd",
            "args": [
                "compile"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\Backend"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
